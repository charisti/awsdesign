<?php

/**
 * @file
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\addtocal_augment\Hook\AddtocalAugmentHooks;

/**
 * @file
 * Contains addtocal_augment.module.
 */

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function addtocal_augment_theme($existing, $type, $theme, $path) {
  return \Drupal::service(AddtocalAugmentHooks::class)->theme($existing, $type, $theme, $path);
}
