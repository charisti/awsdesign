<?php

/**
 * @file
 * Theme and preprocess functions for forms.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\radix\Hook\FormHooks;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 *
 * @phpstan-param list<string> $suggestions
 * @phpstan-param array<string, mixed> $variables
 */
#[LegacyHook]
function radix_theme_suggestions_form_alter(array &$suggestions, array &$variables): void {
  FormHooks::themeSuggestionsFormAlter($suggestions, $variables);
}

/**
 * Implements hook_preprocess_input().
 *
 * @phpstan-param array<string, mixed> $variables
 */
#[LegacyHook]
function radix_preprocess_input(array &$variables): void {
  FormHooks::preprocessInput($variables);
}

/**
 * Implements hook_preprocess_form_element().
 *
 * @phpstan-param array<string, mixed> $variables
 */
#[LegacyHook]
function radix_preprocess_form_element(array &$variables): void {
  FormHooks::preprocessFormElement($variables);
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * @phpstan-param array<string, mixed> $form
 */
#[LegacyHook]
function radix_form_search_block_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  (new FormHooks())->formSearchBlockFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_form_alter().
 *
 * @phpstan-param array<string, mixed> $form
 */
#[LegacyHook]
function radix_form_alter(array &$form, FormStateInterface $form_state): void {
  FormHooks::formAlter($form, $form_state);
}
